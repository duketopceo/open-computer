// Public demo: static assets only. No `main` (no Worker code), no bindings, no vars, no secrets, so nothing in this
// deployment can reach the owner's machines or keys. Not deployed from this repo: the owner runs `wrangler deploy` by hand
// (docs/runbooks/demo-deploy.md). `name` is a placeholder; put Cloudflare Access in front of it before sharing the URL.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-computer-demo",
  "compatibility_date": "2026-11-01",
  // No ungated *.workers.dev or preview URL: the only way in is the Access-protected custom hostname.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../ui/dist-demo",
    "not_found_handling": "single-page-application"
  }
}
