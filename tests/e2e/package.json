{
  "name": "oc-console-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test console.e2e.mjs spa.e2e.mjs workspace.e2e.mjs workspace-gates.e2e.mjs",
    "test:spa": "node --test spa.e2e.mjs",
    "test:a11y": "node --test --test-name-pattern=@a11y console.e2e.mjs workspace-gates.e2e.mjs",
    "test:keyboard": "node --test --test-name-pattern=@keyboard console.e2e.mjs workspace.e2e.mjs",
    "test:workspace": "node --test workspace.e2e.mjs",
    "test:replay": "node --test --test-name-pattern=@replay workspace.e2e.mjs",
    "test:approval": "node --test --test-name-pattern=@approval workspace.e2e.mjs",
    "test:live": "node --test --test-name-pattern=@live workspace.e2e.mjs",
    "test:artifacts": "node --test --test-name-pattern=@artifacts workspace-gates.e2e.mjs",
    "test:gates": "node --test workspace-gates.e2e.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "axe-core": "^4.10.0",
    "playwright": "^1.50.0"
  }
}
